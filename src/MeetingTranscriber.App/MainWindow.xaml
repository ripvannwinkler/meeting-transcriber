<Window
  x:Class="MeetingTranscriber.App.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  mc:Ignorable="d"
  Title="Meeting Transcriber"
  Height="450"
  Width="560"
>
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0">
      <TextBlock FontWeight="Bold" Text="Speaker output device (loopback)" />
      <ComboBox x:Name="LoopbackCombo" Margin="0,4,0,12" />
      <TextBlock FontWeight="Bold" Text="Microphone" />
      <ComboBox x:Name="MicCombo" Margin="0,4,0,12" />
      <Label Content="Microphone gain" Padding="0" />
      <Slider
        x:Name="MicGainSlider"
        Minimum="0"
        Maximum="4"
        Value="1"
        TickFrequency="0.1"
        IsSnapToTickEnabled="False"
      />
    </StackPanel>

    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,8">
      <Button
        x:Name="StartButton"
        Content="Start Recording"
        Width="140"
        Padding="8,4"
        Click="OnStartClick"
      />
      <Button
        x:Name="StopButton"
        Content="Stop Recording"
        Width="140"
        Padding="8,4"
        Margin="8,0,0,0"
        IsEnabled="False"
        Click="OnStopClick"
      />
    </StackPanel>

    <TextBlock x:Name="TimerText" Grid.Row="2" FontSize="20" FontWeight="Bold" />

    <TextBlock x:Name="StatusText" Grid.Row="4" TextWrapping="Wrap" Margin="0,8,0,0" />
  </Grid>
</Window>
