<Window
  x:Class="MeetingTranscriber.App.SettingsWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="Settings"
  Height="560"
  Width="560"
  WindowStartupLocation="CenterOwner"
>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="16" MaxWidth="520">
      <GroupBox Header="Summarization API (OpenAI-compatible)">
        <StackPanel Margin="8">
          <TextBlock Text="Base URL (e.g. http://localhost:1234/v1, https://api.openai.com/v1)" />
          <TextBox
            Text="{Binding BaseUrl, UpdateSourceTrigger=PropertyChanged}"
            Margin="0,4,0,12"
          />

          <TextBlock Text="API key (leave blank for local servers)" />
          <TextBox Text="{Binding ApiKey, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12" />

          <TextBlock Text="Model" />
          <ComboBox
            IsEditable="True"
            Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}"
            ItemsSource="{Binding ModelSuggestions}"
            SelectedItem="{Binding SelectedModelSuggestion}"
            Margin="0,4,0,8"
          />

          <TextBlock Text="Max output tokens" />
          <TextBox
            Text="{Binding MaxTokens, UpdateSourceTrigger=PropertyChanged}"
            Margin="0,4,0,12"
          />

          <StackPanel Orientation="Horizontal">
            <Button
              Content="Test Connection / List Models"
              Command="{Binding TestConnectionCommand}"
              Padding="10,4"
            />
            <Button
              Content="Refresh"
              Command="{Binding RefreshModelsCommand}"
              Padding="10,4"
              Margin="8,0,0,0"
            />
          </StackPanel>
          <TextBlock
            Text="{Binding Status}"
            TextWrapping="Wrap"
            Margin="0,8,0,0"
            Foreground="#444"
          />
        </StackPanel>
      </GroupBox>

      <GroupBox Header="Speech-to-text (local Whisper)" Margin="0,12,0,0">
        <StackPanel Margin="8">
          <TextBlock Text="Model variant" />
          <ComboBox
            ItemsSource="{Binding Variants}"
            SelectedItem="{Binding SelectedVariant}"
            Margin="0,4,0,12"
          />

          <CheckBox
            Content="Download model into local cache if missing"
            IsChecked="{Binding AutoDownload}"
            Margin="0,0,0,12"
          />

          <TextBlock Text="Compute device (cuda / cpu)" />
          <TextBox Text="{Binding Device, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12" />

          <TextBlock Text="Cache folder (relative to project root)" />
          <TextBox
            Text="{Binding CacheDir, UpdateSourceTrigger=PropertyChanged}"
            Margin="0,4,0,8"
          />
        </StackPanel>
      </GroupBox>

      <GroupBox Header="Output" Margin="0,12,0,0">
        <StackPanel Margin="8">
          <TextBlock Text="Results folder (relative to project root)" />
          <TextBox
            Text="{Binding OutputDir, UpdateSourceTrigger=PropertyChanged}"
            Margin="0,4,0,0"
          />
        </StackPanel>
      </GroupBox>

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
        <Button Content="Cancel" Command="{Binding CancelCommand}" Padding="14,4" IsCancel="True" />
        <Button
          Content="Save"
          Command="{Binding SaveCommand}"
          Padding="14,4"
          Margin="8,0,0,0"
          IsDefault="True"
        />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</Window>
